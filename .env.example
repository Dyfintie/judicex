# Judicex Environment Configuration

# Primary LLM Provider: groq, ollama, openai, anthropic, openai_compatible, none
JUDICEX_LLM_PROVIDER=groq
JUDICEX_AREA=civil
JUDICEX_PORT=5051
JUDICEX_BIND=127.0.0.1
JUDICEX_DB=./memory.db

# Groq (Recommended for fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
JUDICEX_OCR_MODEL=glm-5:cloud

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI-Compatible Endpoints (vLLM, LocalAI, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=local-model
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
